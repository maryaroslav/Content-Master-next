{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "generate"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false,
      "persistent": true
    },
    "circular": {
      "dependsOn": [
        "generate"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build",
        "generate"
      ],
      "cache": false
    },
    "generate": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "src/generated/**"
      ]
    }
  }
}
