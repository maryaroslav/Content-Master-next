{
  "name": "@cm/api-client",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "circular": "depcruise src --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cm/contracts": "workspace:*",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "@cm/config-eslint": "workspace:*",
    "@cm/config-ts": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "orval": "8.40.0",
    "react": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5",
    "react": ">=19"
  }
}
