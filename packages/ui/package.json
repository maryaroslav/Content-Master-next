{
  "name": "@cm/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test .storybook",
    "test": "vitest run",
    "circular": "depcruise src --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cm/config-eslint": "workspace:*",
    "@cm/config-ts": "workspace:*",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "playwright": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/icons-material": ">=9",
    "@mui/material": ">=9",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
