# Copy to `.env` and fill in. Validated on startup by src/config/env.ts.

# development | test | production
NODE_ENV=development
PORT=5001
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=3306
DB_NAME=content_master
DB_USER=root
DB_PASS=

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime (15m, 1h, ...) and refresh token lifetime in days
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Encrypts 2FA secrets in the database. Generate with: openssl rand -hex 32
TWOFA_ENCRYPTION_KEY=

# Where uploaded files are stored (relative to apps/api or absolute)
UPLOAD_DIR=uploads

# Comma-separated frontend origins allowed by CORS and Socket.IO
CORS_ORIGINS=http://localhost:3000
