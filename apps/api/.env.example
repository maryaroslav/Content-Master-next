# Copy to `.env` and fill in. Validated on startup by src/config/env.ts.

# development | test | production
NODE_ENV=development
PORT=5001

DB_HOST=localhost
DB_PORT=3306
DB_NAME=content_master
DB_USER=root
DB_PASS=

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Comma-separated frontend origins allowed by CORS and Socket.IO
CORS_ORIGINS=http://localhost:3000
