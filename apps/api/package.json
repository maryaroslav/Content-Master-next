{
  "name": "@cm/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/db/cli.ts up && tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/cli.ts up",
    "db:rollback": "tsx src/db/cli.ts down",
    "db:status": "tsx src/db/cli.ts pending",
    "db:migrate:prod": "node dist/db/cli.js up",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "circular": "depcruise src --config ../../.dependency-cruiser.cjs --ts-config tsconfig.json"
  },
  "dependencies": {
    "@cm/contracts": "workspace:*",
    "bcrypt": "5.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "1.4.5-lts.2",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "sequelize": "6.37.8",
    "sharp": "0.34.5",
    "socket.io": "4.8.4",
    "speakeasy": "2.0.0",
    "umzug": "3.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cm/config-eslint": "workspace:*",
    "@cm/config-ts": "workspace:*",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/speakeasy": "2.0.10",
    "eslint": "9.39.5",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
