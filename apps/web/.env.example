# Copy to `.env.local` and fill in.

# Where the Express API runs (Next rewrites /api/v1 and /uploads to it)
API_ORIGIN=http://localhost:5001

# Sent to the browser through /env.js at request time (no rebuild needed to change them)
API_URL=/api/v1
APP_ENV=development
# Socket.IO origin for the chat; the API's CORS_ORIGINS must allow this app's origin
REALTIME_URL=http://localhost:5001
