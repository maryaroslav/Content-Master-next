{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,route,error,loading,not-found}.{ts,tsx}"
      ]
    },
    "apps/api": {
      "ignoreDependencies": [
        "mysql2"
      ],
      "entry": [
        "src/db/migrations/*.ts"
      ]
    },
    "packages/config-ts": {
      "ignoreDependencies": [
        "next"
      ]
    },
    "packages/*": {}
  },
  "rules": {
    "files": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
