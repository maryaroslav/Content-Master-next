# Copy to `.env` for docker compose (docker-compose.yml). Local development uses apps/*/.env instead.

# MySQL passwords of the database container
MYSQL_ROOT_PASSWORD=
DB_PASS=

# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
# Encrypts 2FA secrets in the database. Generate with: openssl rand -hex 32
TWOFA_ENCRYPTION_KEY=

# Host ports and the addresses the browser uses; change them together
WEB_PORT=3000
API_PORT=5001
WEB_ORIGIN=http://localhost:3000
REALTIME_URL=http://localhost:5001
